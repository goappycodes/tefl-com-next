# teflinstitute.com headless frontend — environment variables.
# Copy to `.env.local` for local dev; set the same keys in Vercel for deploys.
# `.env.local` is gitignored — this file is the committed reference.

# ── Domains ────────────────────────────────────────────────────────────────
# Two independent origins. Keep them separate — the cutover is a change to these
# two values (plus the CDN path-proxy for WordPress-owned paths), not a code change.
#
# WordPress BACKEND: render API, AJAX, media (/wp-content), cart, checkout.
#   today:   https://teflinstitute.com
#   cutover: https://cms.teflinstitute.com   (WP moves to its own subdomain)
NEXT_PUBLIC_WP_ORIGIN=https://teflinstitute.com

# Public FRONT origin: the domain in the address bar. Used for sitemap/robots
# URLs (lib/site.ts). Stays teflinstitute.com throughout.
NEXT_PUBLIC_SITE_ORIGIN=https://teflinstitute.com

# ── Tracking ───────────────────────────────────────────────────────────────
# "1" runs the page's tracking scripts (GTM, gtag/Ads, Meta, Awin, PageSense,
# Ahrefs…). Leave unset on staging/previews so test traffic never reaches the
# live analytics or ad conversions; set to 1 on production at cutover.
# NEXT_PUBLIC_ENABLE_TRACKING=1

# ── Secrets (server-only — never prefix NEXT_PUBLIC) ─────────────────────────
# On-demand ISR revalidation secret; must match TEFL_ISR_SECRET in WordPress'
# wp-config.php (wordpress/tefl-isr-revalidate.php). Use a strong random value.
ISRSECRET=replace-me
